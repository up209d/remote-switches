# Copy to .env and fill in. .env is gitignored — the real credentials never
# get committed. deploy.sh merges these into the settings.json it uploads.
WIFI_SSID=your-network
WIFI_PASS=your-password

UPTUNNEL_SERVER=wss://tunnel.example.com/control
UPTUNNEL_TOKEN=your-device-token-here
UPTUNNEL_SUBDOMAIN=your-allowed-subdomain-here

GEMINI_API_KEY=your-gemini-api-key-here