# Secrets — Wi-Fi credentials, merged into settings.json at deploy time
.env

# Web app build output (deploy.sh regenerates it from web/)
www/

# Runtime state written by the device itself. Any *.log at the root is a device
# log (server/logs.py lists them all for the web app), never source.
state.json
*.log
*.log.tmp

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/

# Local tooling / editor state
.codegraph/
.claude/settings.local.json

# macOS
.DS_Store
